# Copy to .env and fill in.
#
# Local stack (npm run db:start prints these; anon key is the "anon key" line):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Hosted project instead: Project Settings → API on supabase.com
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
#
# Phone via Expo Go against the local stack? 127.0.0.1 is the phone itself —
# use your Mac's LAN IP (ipconfig getifaddr en0), e.g. http://192.168.1.20:54321
# Android emulator: http://10.0.2.2:54321
